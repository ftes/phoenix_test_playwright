#!/bin/sh
# Releases a version: scripts/release [--dry-run] <version>; --check checks the release config
# (CI runs it). See CONTRIBUTING.md "Releasing". The script is ftes/ci's release/release.exs at
# the commit below, which Renovate bumps; this repo's settings are scripts/release_config.exs.
set -eu
cd "$(dirname "$0")/.."
ref=a43fdddf90886b9a8e8c766677e1d5b781efa813 # v1.0.8
script=$(mktemp)
trap 'rm -f "$script"' EXIT
curl -fsSL --retry 3 "https://raw.githubusercontent.com/ftes/ci/$ref/release/release.exs" -o "$script"
elixir -r scripts/release_config.exs -r "$script" -e 'ReleaseScript.main(System.argv())' -- "$@"
